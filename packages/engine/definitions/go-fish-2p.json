{
  "id": "go-fish-2p",
  "schemaVersion": "0.3",
  "metadata": {
    "name": "Go Fish",
    "version": "0.3.0",
    "description": "Two-player Go Fish modeled with generic Communicate, ZoneTransfer-capable rules, attributes, and game state."
  },
  "gameSetup": {
    "players": [
      { "id": 0, "type": "Null" },
      { "id": 1, "type": "Human" },
      { "id": 2, "type": "Human" }
    ],
    "cards": {
      "decks": 1,
      "suits": ["Hearts", "Diamonds", "Clubs", "Spades"],
      "values": [
        { "name": "Ace", "value": 1, "rank": 1 },
        { "name": "2", "value": 2, "rank": 2 },
        { "name": "3", "value": 3, "rank": 3 },
        { "name": "4", "value": 4, "rank": 4 },
        { "name": "5", "value": 5, "rank": 5 },
        { "name": "6", "value": 6, "rank": 6 },
        { "name": "7", "value": 7, "rank": 7 },
        { "name": "8", "value": 8, "rank": 8 },
        { "name": "9", "value": 9, "rank": 9 },
        { "name": "10", "value": 10, "rank": 10 },
        { "name": "Jack", "value": 11, "rank": 11 },
        { "name": "Queen", "value": 12, "rank": 12 },
        { "name": "King", "value": 13, "rank": 13 }
      ]
    },
    "zoneDefinitions": [
      { "label": "D1", "type": "Draw", "visibility": "Hidden" },
      { "label": "P1-Hand", "type": "Hand", "visibility": "Player", "player": 1 },
      { "label": "P2-Hand", "type": "Hand", "visibility": "Player", "player": 2 },
      { "label": "P1-Books", "type": "Book", "visibility": "Public", "player": 1 },
      { "label": "P2-Books", "type": "Book", "visibility": "Public", "player": 2 }
    ],
    "actions": [
      {
        "name": "AskForRank",
        "type": "Communicate",
        "initiator": "Player",
        "message": "Do you have any {{GameState.Variables.RequestCard}}?",
        "predicate": "GameState.Actor.hand.count > 0 and Action.target != GameState.Actor and GameState.Variables.RequestCard in GameState.Actor.hand.ranks",
        "effects": [
          {
            "name": "AnswerYesWithRank",
            "type": "Communicate",
            "initiator": "Trigger",
            "predicate": "GameState.Variables.RequestCard in Action.target.hand.ranks",
            "message": "Yes, I have {GameState.Variables.RequestCard}.",
            "effects": [
              {
                "name": "TransferRequestedRank",
                "type": "ZoneTransfer",
                "initiator": "Trigger",
                "predicate": "GameState.Variables.RequestCard in Action.target.hand.ranks",
                "source": "Action.target.hand",
                "destination": "GameState.Actor.hand",
                "selection": "Where(card.rank = GameState.Variables.RequestCard)",
                "placement": "Top"
              }
            ]
          },
          {
            "name": "AnswerNoWithRank",
            "type": "Communicate",
            "initiator": "Trigger",
            "predicate": "not GameState.Variables.RequestCard in Action.target.hand.ranks",
            "message": "Go fish.",
            "effects": [
              {
                "name": "DrawFromStock",
                "type": "ZoneTransfer",
                "initiator": "Trigger",
                "predicate": "GameState.Zones[\"D1\"].count > 0",
                "source": "GameState.Zones[\"D1\"]",
                "destination": "GameState.Actor.hand",
                "selection": "Top(1)",
                "placement": "Top"
              }
            ]
          }
        ]
      }
    ],
    "completion": {
      "predicate": "(GameState.Zones[\"P1-Books\"].count + GameState.Zones[\"P2-Books\"].count = 52) or (GameState.Zones[\"D1\"].count = 0 and GameState.Zones[\"P1-Hand\"].count = 0 and GameState.Zones[\"P2-Hand\"].count = 0)"
    }
  },
  "gameState": {
    "turn": {
      "actor": 1,
      "minimumActions": 1,
      "maximumActions": 1
    },
    "stateType": "Initial",
    "variables": {
      "phase": "Ask",
      "RequestCard": null
    },
    "zones": [
      { "label": "P1-Hand", "count": 7 },
      { "label": "P2-Hand", "count": 7 },
      { "label": "D1", "count": 38 },
      { "label": "P1-Books", "count": 0 },
      { "label": "P2-Books", "count": 0 }
    ],
    "distribution": "Random"
  }
}
