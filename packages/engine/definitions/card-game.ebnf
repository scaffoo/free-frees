(*
   Generic Traditional Card Game Definition Language, draft 0.1.
   This grammar describes the abstract language. JSON is one serialization of
   this grammar; it is not the language itself.

   External grammar dependency:
     card-game-exp.ebnf defines Expression, PlayerExpr, ZoneRef, Identifier,
     String, Integer, Literal.
*)

GameDefinition      = "{",
                      '"id"', ":", Identifier, ",",
                      '"schemaVersion"', ":", String, ",",
                      Metadata,
                      GameSetup,
                      GameState,
                      "}" ;

Metadata            = "name", String,
                      [ "version", String ],
                      [ "description", String ] ;

GameSetup           = "gameSetup", "{",
                      Players,
                      Cards,
                      ZoneDefinitions,
                      Actions,
                      Completion,
                      "}" ;

Players             = '"players"', ":", "[", PlayerDefinition, { ",", PlayerDefinition }, "]" ;
PlayerDefinition    = "{", '"id"', ":", Integer, ",", '"type"', ":", PlayerType, "}" ;
PlayerType          = "Human" | "Bot" | "Null" ;

Cards               = "cards", "{",
                      "decks", Integer,
                      "suits", "=", SuitSet,
                      "values", "=", ValueSet,
                      "}" ;
SuitSet             = "[", Identifier, { ",", Identifier }, "]" ;
ValueSet            = "[", CardValue, { ",", CardValue }, "]" ;
CardValue           = "{", "name", String, "value", Integer, "rank", Integer, "}" ;

(*
   Zones are named, ordered containers for cards. A game defines whatever zones
   it needs to model its layout and state: hands, stock/draw piles, discards,
   tableaux, foundations, tricks, meld areas, books, or game-specific custom
   areas.

   Prefer representing card state by moving cards between granular zones rather
   than by adding special card flags. For example, one visible solitaire tableau
   stack is modeled as two zones with the same column attribute:

     { "label": "T3-Down", "type": "Tableau", "visibility": "Hidden",
       "attributes": { "column": 3 } }

     { "label": "T3-Up", "type": "Tableau", "visibility": "Public",
       "attributes": { "column": 3 } }

   Turning over a facedown tableau card is then just a ZoneTransfer from
   T3-Down to T3-Up. The draw pile, waste pile, and suit foundations are also
   zones.
*)
ZoneDefinitions     = '"zoneDefinitions"', ":", "[", ZoneDefinition, { ",", ZoneDefinition }, "]" ;
ZoneDefinition      = "{",
                      '"label"', ":", Identifier, ",",
                      '"type"', ":", ZoneType, ",",
                      '"visibility"', ":", ZoneVisibility,
                      (*
                         Optional owning player for player-specific zones.
                      *)
                      [ ",", '"player"', ":", Integer ],
                      [ ",", '"attributes"', ":", "{", AttributeSet, "}" ],
                      "}" ;
ZoneType            = "Draw" |
                      "Discard" |
                      "Hand" |
                      "Book" |
                      "Tableau" |
                      "Foundation" |
                      "Trick" |
                      "Meld" |
                      Identifier ;
ZoneVisibility      = "Hidden" | "Public" | "Player" | Identifier ;
AttributeSet        = [ Attribute, { ",", Attribute } ] ;
Attribute           = Identifier, "=", Literal ;

GameState           = "gameState", "{",
                      Turn,
                      StateTypeValue,
                      Variables,
                      ZoneStates,
                      [ "distribution", Distribution ],
                      "}" ;

Turn                = "turn", "{",
                      "actor", PlayerExpr,
                      [ "minimumActions", Integer ],
                      [ "maximumActions", MaximumActions ],
                      "}" ;
MaximumActions      = Integer | "unbounded" ;

StateTypeValue      = "stateType", StateType ;
StateType           = "Initial" | "InPlay" | "Completion" | Identifier ;

Variables           = "variables", "{", AttributeSet, "}" ;

ZoneStates          = "zones", "[", ZoneState, { ",", ZoneState }, "]" ;
ZoneState           = ZoneRef, "{",
                      [ "cards", "=", CardList ],
                      [ "count", "=", Integer ],
                      [ "attributes", "=", AttributeSet ],
                      "}" ;
CardList            = "[", [ Identifier, { ",", Identifier } ], "]" ;
Distribution        = "Random" | "Ordered" ;

Actions             = '"actions"', ":", "[", Action, { ",", Action }, "]" ;
Action              = "{",
                      ActionField,
                      { ",", ActionField },
                      "}" ;
ActionField         = ActionNameField |
                      ActionTypeField |
                      ActionInitiatorField |
                      ActionPredicateField |
                      ActionMessageField |
                      ActionSourceField |
                      ActionDestinationField |
                      ActionSelectionField |
                      ActionPlacementField |
                      Effects ;
ActionNameField     = '"name"', ":", Identifier ;
ActionTypeField     = '"type"', ":", ActionType ;
ActionInitiatorField = '"initiator"', ":", ActionInitiator ;
ActionPredicateField = '"predicate"', ":", Expression ;
ActionMessageField  = '"message"', ":", String ;
ActionSourceField   = '"source"', ":", Expression ;
ActionDestinationField = '"destination"', ":", Expression ;
ActionSelectionField = '"selection"', ":", Expression ;
ActionPlacementField = '"placement"', ":", Expression ;
ActionInitiator     = "Player" | "Trigger" ;
ActionType          = "ZoneTransfer" | "Communicate" | Identifier ;

(*
   Effects are an ordered list of actions caused by the containing action.
   Each effect action may have its own predicate. Effects are evaluated in list
   order against the current game state at that point; if an effect applies, it
   mutates state before the next effect predicate is evaluated. Branching is
   represented by effect predicates rather than by a separate effect-level
   logical operator.
*)
Effects             = '"effects"', ":", "[", [ Action, { ",", Action } ], "]" ;

Completion          = "completion", "{", Expression, "}" ;
